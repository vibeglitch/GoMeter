{
  "name": "tensilix",
  "displayName": "Tensilix - API Load Testing & Performance Engine",
  "description": "High-performance API load tester, stress testing engine, and real-time performance telemetry. Zero-dependency Go core, multi-step session chaining, and MCP AI integration.",
  "version": "1.6.2",
  "publisher": "vibeglitch-sdlc",
  "repository": {
    "type": "git",
    "url": "https://github.com/vibeglitch/Tensilix"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Testing",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "tensilix",
    "load-testing",
    "api-testing",
    "stress-testing",
    "performance",
    "benchmarking",
    "mcp",
    "jmeter",
    "k6"
  ],
  "icon": "resources/icon.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gometer-sidebar",
          "title": "Tensilix",
          "icon": "resources/activitybar.svg"
        }
      ]
    },
    "views": {
      "gometer-sidebar": [
        {
          "id": "gometer.testPlansView",
          "name": "Test Plans",
          "contextualTitle": "Tensilix Test Plans"
        }
      ]
    },
    "commands": [
      {
        "command": "gometer.runActiveTest",
        "title": "Tensilix: Run Current Test Plan",
        "icon": "$(play)"
      },
      {
        "command": "gometer.runTestFile",
        "title": "Tensilix: Run Test Plan",
        "icon": "$(play)"
      },
      {
        "command": "gometer.openDashboard",
        "title": "Tensilix: Open Live Dashboard",
        "icon": "$(graph-line)"
      },
      {
        "command": "gometer.generateTestWithAI",
        "title": "Tensilix: Generate Test Plan with AI",
        "icon": "$(sparkle)"
      },
      {
        "command": "gometer.analyzeReportWithAI",
        "title": "Tensilix: Analyze Test Results with AI",
        "icon": "$(beaker)"
      },
      {
        "command": "gometer.validateTestPlan",
        "title": "Tensilix: Validate Test Plan",
        "icon": "$(check)"
      },
      {
        "command": "gometer.initTestPlan",
        "title": "Tensilix: Create Starter Test Plan",
        "icon": "$(new-file)"
      },
      {
        "command": "gometer.stopActiveTest",
        "title": "Tensilix: Stop Running Test",
        "icon": "$(debug-stop)"
      },
      {
        "command": "gometer.refreshTestPlans",
        "title": "Tensilix: Refresh Test Plans",
        "icon": "$(refresh)"
      },
      {
        "command": "gometer.newFolder",
        "title": "Tensilix: New Folder...",
        "icon": "$(new-folder)"
      },
      {
        "command": "gometer.newTestPlanInFolder",
        "title": "Tensilix: New Test Plan...",
        "icon": "$(new-file)"
      },
      {
        "command": "gometer.deleteTestPlan",
        "title": "Tensilix: Delete",
        "icon": "$(trash)"
      },
      {
        "command": "gometer.exportPlanAsCsv",
        "title": "Tensilix: Export Test Results as CSV...",
        "icon": "$(export)"
      },
      {
        "command": "gometer.exportFolderAsCsv",
        "title": "Tensilix: Export Folder Test Results as CSV...",
        "icon": "$(export)"
      },
      {
        "command": "gometer.installAgentSkill",
        "title": "Tensilix: Install AI Coding Agent Skill",
        "icon": "$(sparkle)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gometer.refreshTestPlans",
          "when": "view == gometer.testPlansView",
          "group": "navigation@0"
        },
        {
          "command": "gometer.newFolder",
          "when": "view == gometer.testPlansView",
          "group": "navigation@0.5"
        },
        {
          "command": "gometer.initTestPlan",
          "when": "view == gometer.testPlansView",
          "group": "navigation@1"
        },
        {
          "command": "gometer.generateTestWithAI",
          "when": "view == gometer.testPlansView",
          "group": "navigation@2"
        },
        {
          "command": "gometer.openDashboard",
          "when": "view == gometer.testPlansView",
          "group": "navigation@3"
        },
        {
          "command": "gometer.exportFolderAsCsv",
          "when": "view == gometer.testPlansView",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "gometer.newTestPlanInFolder",
          "when": "viewItem == testPlanFolder",
          "group": "inline@1"
        },
        {
          "command": "gometer.newFolder",
          "when": "viewItem == testPlanFolder",
          "group": "inline@2"
        },
        {
          "command": "gometer.exportFolderAsCsv",
          "when": "viewItem == testPlanFolder",
          "group": "inline@3"
        },
        {
          "command": "gometer.newTestPlanInFolder",
          "when": "viewItem == testPlanFolder",
          "group": "1_actions@1"
        },
        {
          "command": "gometer.newFolder",
          "when": "viewItem == testPlanFolder",
          "group": "1_actions@2"
        },
        {
          "command": "gometer.exportFolderAsCsv",
          "when": "viewItem == testPlanFolder",
          "group": "1_actions@3"
        },
        {
          "command": "gometer.deleteTestPlan",
          "when": "viewItem == testPlanFolder",
          "group": "2_delete"
        },
        {
          "command": "gometer.runTestFile",
          "when": "viewItem == testPlanFile",
          "group": "inline@1"
        },
        {
          "command": "gometer.validateTestPlan",
          "when": "viewItem == testPlanFile",
          "group": "inline@2"
        },
        {
          "command": "gometer.exportPlanAsCsv",
          "when": "viewItem == testPlanFile",
          "group": "inline@3"
        },
        {
          "command": "gometer.runTestFile",
          "when": "viewItem == testPlanFile",
          "group": "1_actions@1"
        },
        {
          "command": "gometer.validateTestPlan",
          "when": "viewItem == testPlanFile",
          "group": "1_actions@2"
        },
        {
          "command": "gometer.exportPlanAsCsv",
          "when": "viewItem == testPlanFile",
          "group": "1_actions@3"
        },
        {
          "command": "gometer.deleteTestPlan",
          "when": "viewItem == testPlanFile",
          "group": "2_delete"
        }
      ],
      "editor/title": [
        {
          "command": "gometer.runActiveTest",
          "when": "resourceExtname == .yaml || resourceExtname == .yml",
          "group": "navigation@0"
        },
        {
          "command": "gometer.exportPlanAsCsv",
          "when": "resourceExtname == .yaml || resourceExtname == .yml",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "Tensilix",
      "properties": {
        "tensilix.binaryPath": {
          "type": "string",
          "default": "",
          "description": "Path to the tensilix/gometer executable binary. If empty, uses bundled or PATH binary."
        },
        "tensilix.defaultOutputFormat": {
          "type": "string",
          "default": "json",
          "enum": [
            "json",
            "html",
            "console",
            "all"
          ],
          "description": "Report output format"
        },
        "tensilix.reportDirectory": {
          "type": "string",
          "default": "./reports",
          "description": "Directory where reports are stored"
        },
        "gometer.binaryPath": {
          "type": "string",
          "default": "",
          "description": "Legacy alias for tensilix.binaryPath."
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": [
          "*.tensilix.yaml",
          "*.tensilix.yml",
          "*tensilix*.yaml",
          "*tensilix*.yml",
          "*.gometer.yaml",
          "*.gometer.yml",
          "*gometer*.yaml",
          "*gometer*.yml"
        ],
        "url": "./schemas/tensilix.schema.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.25.0",
    "js-yaml": "^4.1.0",
    "typescript": "^5.7.0"
  }
}